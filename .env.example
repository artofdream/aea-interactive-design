# Copy to `.env` and adjust. Never commit `.env`.

DATABASE_URL=postgresql://cafe:cafe@127.0.0.1:5432/cafe_fausse
DB_CONNECT_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=2000
PORT=5000

# Future #135 — optional SES confirmation after FR-15/16 store. Leave unset for store-only.
# Signup still succeeds if these are missing (email_delivery.status = skipped).
# SES_REGION=us-east-1
# SES_FROM_EMAIL=newsletter@cafe.artof.link
# SES_CONFIGURATION_SET=
# PUBLIC_BASE_URL=https://cafe.artof.link
# Prefer an IAM instance role on Lightsail. Keys are optional and must stay out of git:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
